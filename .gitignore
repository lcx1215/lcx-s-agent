# Local build caches left behind after the macOS/Android app surfaces were
# dropped. Their tracked trees are gone from the index, but the caches stay
# on disk, so without these rules the change-impact governance scan sees them
# as unowned changed files and fails the owner.
apps/macos/.build/
apps/shared/

# Generated protocol schema (produced via pnpm protocol:gen)
dist/protocol.schema.json
.ant-colony/

# Local runtime state written by operator scripts and runners (branches/_system)
branches/_system/

# Generated extension declaration output
ops/external-channel-artifacts/promotions/

# Eclipse
**/.project
**/.classpath
**/.settings/
**/.gradle/

# Synthing
**/.stfolder/
# Keeps generated output, local credentials, caches, and runtime state out of git.
tmp-lcx-owner-dashboard*.png
