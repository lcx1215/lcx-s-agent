# Copy to deploy/cloud/.env on the cloud host. Never commit the copied file.
# Mount one protected state root and its workspace child during migration.
# Never alias the workspace source to the state root itself. The application
# sees the state root as /home/node/.openclaw in the container.
OPENCLAW_IMAGE=ghcr.io/lcx1215/lcx-s-agent:REPLACE_WITH_VERIFIED_TAG_OR_DIGEST
OPENCLAW_CONFIG_DIR=/var/lib/lcx/state
OPENCLAW_WORKSPACE_DIR=/var/lib/lcx/state/workspace
OPENCLAW_CONTAINER_STATE_DIR=/home/node/.openclaw
OPENCLAW_CONTAINER_CONFIG_PATH=/home/node/.openclaw/openclaw.json
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_GATEWAY_TOKEN=REPLACE_WITH_SECRET_MANAGER_INJECTION
LCX_CLOUD_RUNTIME=1
LCX_LOCAL_VISION_ENABLED=0
